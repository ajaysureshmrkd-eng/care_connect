# api call for listing

###
GET http://127.0.0.1:8000/doctors/
Accept: application/json

# api call for adding

###
POST http://127.0.0.1:8000/doctors/
Content-Type: application/json

{
    "name":"habeeb",
    "specialization":"dermatology",
    "fee": 950,
    "qualification":"MBBS",
    "email":"habeeb@gmail.com"
}

# api call for fetching for details

###
GET http://127.0.0.1:8000/doctors/5/
Accept: application/json


# api call for  update

# api call for delete



