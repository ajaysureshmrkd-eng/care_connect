#=====> serializers endpoint <=======

###
GET http://127.0.0.1:8000/v2/doctors/
Accept: application/json
Authorization: Basic username:username



# api call for adding

###
POST http://127.0.0.1:8000/v2/doctors/
Content-Type: application/json

{
    "name":"ajna",
    "specialization":"dermatology",
    "fee": 950,
    "qualification":"MBBS",
    "email":"achu@gmail.com"
}


# api call for fetching for details

###
GET http://127.0.0.1:8000/v2/doctors/4/
Accept: application/json


# api call for delete

###
DELETE  http://127.0.0.1:8000/v2/doctors/1/
Accept: application/json



# api call for updated

###
PUT http://127.0.0.1:8000/v2/doctors/5/
Content-Type: application/json

{
    "id": "5",
    "name": "achu",
    "specialization": "dermatology",
    "fee": -650,
    "qualification": "MBBS",
    "email": "achu@gmail.com"
  }




